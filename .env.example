# ==============================================================================
# KnowLayer Core Environment Configuration
# ==============================================================================

# LLM Providers (OpenAI / Azure OpenAI as primary, Groq as fallback)
OPENAI_API_KEY=your-openai-api-key-here
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://pcsazureopenai.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
OPENAI_MODEL=gpt-4o
LLM_MODEL=gpt-4o
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Vector Database & Embeddings
CHROMA_HOST=localhost
CHROMA_PORT=8000
COLLECTION_NAME=hr_policy_docs
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOCLING_ENABLED=false
DOCLING_VISUAL_ENRICHMENT_ENABLED=false
DOCLING_VLM_MODEL=qwen2-vl:2b
DOCLING_VLM_BASE_URL=http://localhost:11434
DOCLING_VLM_TIMEOUT_SECONDS=120.0
DOCLING_VLM_MAX_NEW_TOKENS=128
DOCLING_VLM_SELECTIVE_ROUTING=true
DOCLING_OCR_MIN_CONFIDENCE=0.35
DOCLING_SKIP_DECORATIVE_OCR=true
DOCLING_PDF_OCR_SCALE=1.5
DOCLING_SKIP_BLANK_PAGES=true
DOCLING_AUTO_OCR_SELECTIVE=true
DOCLING_NUM_THREADS=8
DOCLING_CITATION_PDF_ENABLED=false
DOCLING_LIBREOFFICE_PATH=
DOCLING_MAX_TOKENS=256
DOCUMENTS_DIR=./input
RAG_DISTANCE_THRESHOLD=0.80

# Application Database & Security
DATABASE_URL=sqlite:///./instance/knowlayer.db3
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-before-first-login
AUTH_SECRET_KEY=change-this-development-secret-minimum-32-characters
AUTH_TOKEN_EXPIRE_MINUTES=480

# Networking (For local development outside Docker; overridden inside Docker network)
STREAMLIT_API_BASE_URL=http://127.0.0.1:8000

# ==============================================================================
# Observability: Langfuse
# ==============================================================================
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST="https://us.cloud.langfuse.com"
OBSERVABILITY_PROVIDER=langfuse