OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
CHROMA_HOST=localhost
CHROMA_PORT=8000
DOCUMENTS_DIR=./input
COLLECTION_NAME=hr_policy_docs
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=openrouter/anthropic/claude-3.5-sonnet
GROQ_MODEL=openai/gpt-oss-20b

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=knowlayer

# Sequential employee / document id formats
EMPLOYEE_ID_PREFIX=MSS
EMPLOYEE_ID_MIN_DIGITS=3
DOCUMENT_ID_PREFIX=DOC
DOCUMENT_ID_MIN_DIGITS=3

# Email domain used for <first>.<last>@<domain> user emails
EMAIL_DOMAIN=mclarensv.com
