OPENROUTER_API_KEY=key
GROQ_API_KEY=key
CHROMA_HOST=localhost
CHROMA_PORT=8000
DOCUMENTS_DIR=./input
COLLECTION_NAME=hr_policy_docs
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOCLING_ENABLED=false
DOCLING_VISUAL_ENRICHMENT_ENABLED=false
DOCLING_CITATION_PDF_ENABLED=false
DOCLING_LIBREOFFICE_PATH=
DOCLING_MAX_TOKENS=256
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
GROQ_MODEL=openai/gpt-oss-20b
DATABASE_URL=sqlite:///./instance/knowlayer.db3
STREAMLIT_API_BASE_URL=http://127.0.0.1:8000
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-before-first-login
AUTH_SECRET_KEY=change-this-development-secret
AUTH_TOKEN_EXPIRE_MINUTES=480
RAG_DISTANCE_THRESHOLD=0.80

# TypeSafe Jev System-One Decision Model — uses OPENROUTER_API_KEY by default.
# The Jev native Decision API is exclusively available via OpenRouter.
# JEV_API_KEY defaults to OPENROUTER_API_KEY — only set this to override.
# JEV_API_KEY=your_openrouter_key_here
# JEV_MODEL=typesafe/jev-1.14
# JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions